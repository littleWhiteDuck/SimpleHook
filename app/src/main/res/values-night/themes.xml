<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SimpleHook" parent="@style/Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#65A3F0</item>
        <item name="colorPrimaryVariant">#4F9BFA</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.AppSplashScreen" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.SimpleHook</item>
    </style>
    <!--SplashScreen兼容库，静态背景，android5.0 ~ android11-->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen.IconBackground">
        <!--给父主题设置窗口背景-->

        <!--使用透明的drawable替换中心图标，如果不替换在部分旧系统会展示一个机器人-->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <!--需要配置，不配置的话，启动页消失到主页显示的时候，有个过渡动画，会闪这个颜色的背景色-->
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="postSplashScreenTheme">@style/Theme.SimpleHook</item>
    </style>
</resources>
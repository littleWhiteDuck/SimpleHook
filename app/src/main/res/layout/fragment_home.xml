<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.fragment.HomeFragment">

    <TextView
        android:id="@+id/empty_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/main_home_empty_tip"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/progressBar2"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/main_recycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/sort_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:visibility="gone"
        app:backgroundTint="@color/colorPrimary"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/done_all_24"
        app:tint="@color/white" />

    <me.simpleHook.ui.custom.FloatingActionMenu
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu_src="@drawable/ic_add_24"
        app:menu_tint="@color/white">

        <me.simpleHook.ui.custom.FloatingActionButton
            android:id="@+id/share_configs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:fab_label="@string/home_fab__share_config"
            app:fab_src="@drawable/ic_share"
            app:fab_tint="@color/white"
            app:maxImageSize="15dp" />

        <me.simpleHook.ui.custom.FloatingActionButton
            android:id="@+id/import_configs_from_internet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:fab_label="@string/home_fab_import_config_from_internet"
            app:fab_src="@drawable/ic_cloud_download_12"
            app:fab_tint="@color/white"
            app:maxImageSize="15dp" />

        <me.simpleHook.ui.custom.FloatingActionButton
            android:id="@+id/import_configs_from_paste"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:fab_label="@string/home_fab_import_config_from_clip"
            app:fab_src="@drawable/ic_paste"
            app:fab_tint="@color/white"
            app:maxImageSize="15dp" />

        <me.simpleHook.ui.custom.FloatingActionButton
            android:id="@+id/add_config"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:fab_label="@string/home_fab_add_config"
            app:fab_src="@drawable/ic_add_24"
            app:fab_tint="@color/white"
            app:maxImageSize="15dp" />
    </me.simpleHook.ui.custom.FloatingActionMenu>
</androidx.constraintlayout.widget.ConstraintLayout>
# Optional release-signing configuration. Copy this file to sign.properties and fill it in.
# Local values take priority over SIGNING_* environment variables.
# Without either signing source, debug builds use Android's default debug keystore.
# In GitHub Actions, SIGNING_STORE_FILE should point to a temporary decoded keystore.
verName=0.0.0-dev
alias=your-key-alias
keyPassword=your-key-password
file=/absolute/path/to/your-keystore.jks
password=your-keystore-password
